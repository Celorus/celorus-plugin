#!/usr/bin/env bash
# SessionStart hook for the Celorus plugin: announce the desk, if there is one.
# Reads the desk's stamps (celorus/desk.md; celorus/index.md on a layout 1 desk),
# the seat pointer and the follow-up queue.
# Writes nothing. Makes no network call. Needs bash and coreutils only.
# Never fails the session: every branch exits 0.
set -u

# The kind of the entry at $1, looked at without following it, in the desk tools' words.
odd_kind() {
  if [ -p "$1" ]; then printf 'a pipe'
  elif [ -S "$1" ]; then printf 'a socket'
  elif [ -c "$1" ] || [ -b "$1" ]; then printf 'a device'
  else printf 'neither a file nor a folder'; fi
}

# What a link at $1 leads to, in the desk tools' words.
link_kind() {
  if [ ! -e "$1" ]; then printf 'a link that points nowhere'
  elif [ -d "$1" ]; then printf 'a link to a folder'
  elif [ -f "$1" ]; then printf 'a link to a file'
  else printf 'a link to something that is neither a file nor a folder'; fi
}

# Why the celorus folder $1 holds no index.md the desk tools can read, by its path under the
# desk, or nothing when it does. Nothing is opened: a pipe there would wait for a writer.
index_fault() {
  local f="$1/index.md"
  if [ ! -r "$1" ] || [ ! -x "$1" ]; then
    printf 'celorus/ cannot be read: this machine gives no permission to read or search it'
  elif [ -L "$f" ]; then printf 'celorus/index.md is %s' "$(link_kind "$f")"
  elif [ ! -e "$f" ]; then printf 'celorus/ holds no index.md'
  elif [ -d "$f" ]; then printf 'celorus/index.md is a folder, not a page'
  elif [ ! -f "$f" ]; then printf 'celorus/index.md is %s, not a page' "$(odd_kind "$f")"
  elif [ ! -r "$f" ]; then printf 'celorus/index.md cannot be read: this machine gives no permission to read it'
  fi
}

# Whether folder $1 holds an entry named exactly `celorus`, read in the folder's listing: the glob
# reads the listing and matches case exactly, so on a disk that ignores case (macOS's default) a
# folder named `Celorus`, which a look-up by the name would find, is not it. A folder that cannot
# be listed is looked at by the name, as the engine does.
holds_celorus() {
  if [ -r "$1" ]; then
    local listed=( "$1"/[c]elorus )
    [ "${listed[0]}" = "$1/celorus" ] && { [ -e "${listed[0]}" ] || [ -L "${listed[0]}" ]; }
  else
    [ -e "$1/celorus" ] || [ -L "$1/celorus" ]
  fi
}

# The name of an entry in folder $1's listing that is `celorus` in another case (`Celorus`,
# `CELORUS`) and holds an index.md, or nothing: a desk's record folder misnamed, refused by name
# with the rename, as the engine refuses it. One without an index.md is walked past.
misnamed() {
  [ -r "$1" ] || return 0
  local m
  for m in "$1"/[cC][eE][lL][oO][rR][uU][sS]; do
    [ "$m" = "$1/celorus" ] && continue
    if [ -e "$m/index.md" ] || [ -L "$m/index.md" ]; then printf '%s' "${m##*/}"; return 0; fi
  done
}

# The line for a misnamed entry $1, found by the door $2 says in words.
misnamed_said() {
  local walked=""
  case "$2" in "the first "*) walked=", and the walk stops there: no desk above it is used" ;; esac
  printf '%s/ holds an index.md, but the desk tools read a desk only from a folder named exactly celorus/, so %s is no desk the tools can read%s. Rename %s/ to celorus/, then ask again. Nothing was changed.' \
    "$1" "$2" "$walked" "$1"
}

# The desk the engine would use (the same stop rule): the folder CELORUS_DESK names, or the first
# folder on the walk up from $PWD, that holds an entry named exactly `celorus`, of any kind. Prints that folder and
# returns 0 only when its celorus/ is a plain folder holding a plain, readable index.md. Prints one
# line naming what is wrong, by its path under that folder, and returns 2 otherwise: never a desk
# above it. Returns 1, printing nothing, when the walk finds no celorus entry.
find_desk() {
  local d where m named="${CELORUS_DESK:-}"
  local shape="A desk's celorus/ is a plain folder holding a plain, readable index.md: make it one, then ask again."
  local walk="the first folder on the walk up from the working folder that holds a celorus entry"
  if [ -n "$named" ]; then
    d="$named"
    if ! holds_celorus "$d"; then
      m="$(misnamed "$d")"
      if [ -n "$m" ]; then misnamed_said "$m" "the folder CELORUS_DESK names, ${named},"; return 2; fi
      printf 'CELORUS_DESK names %s, which holds no celorus/index.md. Set CELORUS_DESK to the desk folder (the one holding celorus/index.md), or name that folder as `desk`.' "$named"
      return 2
    fi
    where="so the folder CELORUS_DESK names, ${named}, is no desk the tools can read. ${shape}"
  else
    d="${PWD}"
    while [ -n "$d" ] && [ "$d" != "/" ] && ! holds_celorus "$d"; do
      m="$(misnamed "$d")"
      if [ -n "$m" ]; then misnamed_said "$m" "$walk"; return 2; fi
      d="$(dirname "$d")"
    done
    [ -n "$d" ] && [ "$d" != "/" ] || return 1
    where="so the first folder on the walk up from the working folder that holds a celorus entry is no desk the tools can read, and the walk stops there: no desk above it is used. ${shape}"
  fi
  local e="$d/celorus" fault=""
  if [ -L "$e" ]; then
    local kind
    kind="$(link_kind "$e")"
    if [ "$kind" = "a link to a folder" ]; then
      fault="$(index_fault "$e")"
      if [ -z "$fault" ]; then
        printf 'celorus/ is a link to a folder, in %s: the desk tools read that desk through the link and write nothing through it, and no desk above it is used. Put a plain folder in its place, then ask again.' \
          "$([ -n "$named" ] && printf 'the folder CELORUS_DESK names, %s' "$named" || printf 'the first folder on the walk up from the working folder that holds a celorus entry')"
        return 2
      fi
      [ "$fault" = "celorus/ holds no index.md" ] && fault="celorus/ is a link to a folder that holds no index.md"
    else
      fault="celorus/ is ${kind}"
    fi
  elif [ ! -d "$e" ]; then
    if [ -f "$e" ]; then fault="celorus is a file, not a folder"; else fault="celorus is $(odd_kind "$e"), not a folder"; fi
  else
    fault="$(index_fault "$e")"
  fi
  if [ -n "$fault" ]; then
    printf '%s, %s' "$fault" "$where"
    return 2
  fi
  printf '%s' "$d"
  return 0
}

# frontmatter_value FILE KEY: the first "KEY: value" inside the leading --- block,
# at any indentation, trailing blanks trimmed. A double-quoted value loses its quotes, and each
# backslash keeps only the character after it (\" reads as ", \\ as \; a backslash at the very
# end stays); a single-quoted one loses its quotes, keeps any double quote, and reads a doubled
# single quote as one; any other value loses every double quote. Empty when absent.
frontmatter_value() {
  awk -v key="$2" -v q="'" '
    { sub(/\r$/, "") }
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (index(line, key ":") == 1) {
        v = substr(line, length(key) + 2)
        sub(/^[ \t]+/, "", v)
        sub(/[ \t]+$/, "", v)
        if (length(v) >= 2 && substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") {
          v = substr(v, 2, length(v) - 2)
          out = ""
          for (i = 1; i <= length(v); i++) {
            c = substr(v, i, 1)
            if (c == "\\" && i < length(v)) { i++; c = substr(v, i, 1) }
            out = out c
          }
          v = out
        } else if (length(v) >= 2 && substr(v, 1, 1) == q && substr(v, length(v), 1) == q) {
          v = substr(v, 2, length(v) - 2)
          gsub(q q, q, v)
        } else {
          gsub(/"/, "", v)
        }
        print v
        exit
      }
    }
  ' "$1"
}

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

emit() {
  local ctx
  ctx="$(escape_for_json "$1")"
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$ctx"
  else
    printf '{\n  "additionalContext": "%s"\n}\n' "$ctx"
  fi
}

found=0
desk="$(find_desk)" || found=$?
if [ "$found" -eq 2 ]; then
  emit "Celorus is installed. ${desk}"
  exit 0
elif [ "$found" -ne 0 ]; then
  emit "Celorus is installed. No desk workspace was found here; say 'set up my desk' to create one, or ask what Celorus can do."
  exit 0
fi

stamps="$desk/celorus/desk.md"
[ -f "$stamps" ] || stamps="$desk/celorus/index.md"
desk_name="$(frontmatter_value "$stamps" desk)"
desk_id="$(frontmatter_value "$stamps" desk_id)"
# The id names a file under ~/.celorus, so it is used only when it holds nothing but lowercase
# letters, digits and hyphens, spelled out so no locale widens the range. Anything else reads
# as no id, and no seat pointer is read.
case "$desk_id" in *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) desk_id="" ;; esac

seat="${CELORUS_SEAT:-}"
if [ -z "$seat" ] && [ -n "$desk_id" ] && [ -f "${HOME:-/nonexistent}/.celorus/seat-${desk_id}" ]; then
  seat="$(head -n 1 "${HOME}/.celorus/seat-${desk_id}" | tr -d '[:space:]')"
fi
role=""
if [ -n "$seat" ] && [ -f "$desk/celorus/seats/${seat}.md" ]; then
  role="$(frontmatter_value "$desk/celorus/seats/${seat}.md" role)"
fi
if [ -n "$seat" ]; then
  seat_line="seat ${seat}${role:+ (${role})}"
else
  seat_line="no seat claimed on this machine; say 'set up my desk' to claim one"
fi

today="$(date +%F)"
board="not yet opened"
if [ -f "$desk/celorus/today/${today}.md" ]; then
  opened="$(frontmatter_value "$desk/celorus/today/${today}.md" opened_at)"
  board="opened${opened:+ at ${opened}}"
fi

due=0
queue="$desk/celorus/queues/follow-ups.md"
if [ -f "$queue" ]; then
  due="$(awk -F'|' -v t="$today" '
    !in_table {
      if ($0 ~ /^\|[ -]*-/) in_table = 1
      next
    }
    NF >= 7 {
      by = $(NF-3); st = $(NF-1)
      gsub(/[ \t]/, "", by); gsub(/[ \t]/, "", st)
      if (st == "due" && by != "" && by <= t) n++
    }
    END { print n + 0 }
  ' "$queue")"
fi
if [ "$due" = "1" ]; then
  due_line="1 follow-up is due"
else
  due_line="${due} follow-ups are due"
fi

emit "A Celorus desk is installed at ${desk} for ${desk_name:-this desk}: ${seat_line}.
Today's board is ${board}; ${due_line}.
Open the day with the day-open skill. The chain and the layout are in celorus/index.md."
exit 0
