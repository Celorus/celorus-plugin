#!/usr/bin/env bash
# SessionStart hook for the Celorus plugin: announce the desk, if there is one.
# Reads the desk's stamps (celorus/desk.md; celorus/index.md on a layout 1 desk),
# the seat pointer and the follow-up queue.
# Asks for the version of Node.js once, only to say so when Node.js 18 or newer is missing
# (the desk tools and the sign-in need it; this hook does not).
# Writes nothing. Makes no network call. Needs bash and coreutils only.
# Never fails the session: every branch exits 0.
# Speaks as Milan (DESK-262): every start line opens with "Milan here.", names the next step, and
# ends with the line on signing in to the record, which this hook cannot see (it makes no network
# call), so it says it every time, except the no-desk, no-sign-in line, which asks itself. Milan
# is the engine's default name for the assistant (engine/lib/persona.js DEFAULT_NAME, the one
# reader of a desk's own name): a desk whose desk.md
# sets its own assistant_name is greeted with no name, and this hook never reads or says that name.
# With no desk here, the next step depends on whether the link keeps a sign-in on this machine,
# its token file under ~/.celorus/link/, which is looked at and never opened. The seat's workflow
# page is not on this desk yet, so the next step is read from today's board and the follow-ups due.
# A seat's graph (layout 3, the desk a first bring-down leaves, with no seat pointer here) names
# its seat in its desk.md; that seat is used and its handle never said, since a handle the set-up
# page made carries the seat's number.
# Ends by itself (DESK-276): starts no background child, reads no stdin (it is closed at once, so
# no program here can wait on it), runs the one outside program it asks (the Node.js version) under
# a bound where the machine has GNU timeout, and the walk up from the working folder is capped in
# steps and in seconds. hooks.json gives the hook 10 seconds. The walk stops at 6 and Node.js gets
# what is left of a 9 second budget (at least 1), so a start whose walk stops on the clock is done
# by 9 seconds, 10 at the most. Two things have no bound: the Node.js question where the machine
# has no GNU timeout, and one folder step that the disk is slow to answer.
set -u
# Bash takes the start value of SECONDS from the environment; the hook's clock starts here.
SECONDS=0
exec </dev/null

# The seconds after which the walk up from the working folder gives up, and the most folders it
# climbs.
WALK_SECONDS=6
WALK_STEPS=256

# bounded SECONDS COMMAND ARGUMENT...: COMMAND, found by the PATH and run by that absolute path
# only (an empty PATH entry or a "." would answer with a file in the working folder, which is never
# run), under GNU timeout when the PATH has one, else alone. A timeout in a folder named Windows is
# Windows' own program of that name, and BusyBox's takes other arguments, so neither is used.
# --foreground keeps timeout in the hook's own process group. The bound ends the program it
# started, and kills it one second later (--kill-after=1) if it ignores the first signal. A
# version manager's shim (Volta and the like) runs Node.js as a child of its own, which the bound
# does not reach and which may outlive it: that case is unbounded.
bounded() {
  local secs="$1" prog tm
  shift
  prog="$(command -v "$1" 2>/dev/null)" || return 127
  case "$prog" in /*) ;; *) return 127 ;; esac
  shift
  tm="$(command -v timeout 2>/dev/null)" || tm=""
  case "$tm" in /*) ;; *) tm="" ;; esac
  case "$(readlink "$tm" 2>/dev/null)" in *busybox*) tm="" ;; esac
  case "$tm" in
    ""|*/[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/*) "$prog" "$@" ;;
    *) "$tm" --foreground --kill-after=1 "$secs" "$prog" "$@" ;;
  esac
}

# The kind of the entry at $1, looked at without following it, in the desk tools' words.
odd_kind() {
  if [ -p "$1" ]; then printf 'a pipe'
  elif [ -S "$1" ]; then printf 'a socket'
  elif [ -c "$1" ] || [ -b "$1" ]; then printf 'a device'
  else printf 'neither a file nor a folder'; fi
}

# What a link at $1 leads to, in the desk tools' words.
link_kind() {
  if [ ! -e "$1" ]; then printf 'a link that points nowhere'
  elif [ -d "$1" ]; then printf 'a link to a folder'
  elif [ -f "$1" ]; then printf 'a link to a file'
  else printf 'a link to something that is neither a file nor a folder'; fi
}

# Why the celorus folder $1 holds no index.md the desk tools can read, by its path under the
# desk, or nothing when it does. Nothing is opened: a pipe there would wait for a writer.
index_fault() {
  local f="$1/index.md"
  if [ ! -r "$1" ] || [ ! -x "$1" ]; then
    printf 'celorus/ cannot be read: this machine gives no permission to read or search it'
  elif [ -L "$f" ]; then printf 'celorus/index.md is %s' "$(link_kind "$f")"
  elif [ ! -e "$f" ]; then printf 'celorus/ holds no index.md'
  elif [ -d "$f" ]; then printf 'celorus/index.md is a folder, not a page'
  elif [ ! -f "$f" ]; then printf 'celorus/index.md is %s, not a page' "$(odd_kind "$f")"
  elif [ ! -r "$f" ]; then printf 'celorus/index.md cannot be read: this machine gives no permission to read it'
  fi
}

# Whether folder $1 holds an entry named exactly `celorus`, read in the folder's listing: the glob
# reads the listing and matches case exactly, so on a disk that ignores case (macOS's default) a
# folder named `Celorus`, which a look-up by the name would find, is not it. A folder that cannot
# be listed is looked at by the name, as the engine does.
holds_celorus() {
  if [ -r "$1" ]; then
    local listed=( "$1"/[c]elorus )
    [ "${listed[0]}" = "$1/celorus" ] && { [ -e "${listed[0]}" ] || [ -L "${listed[0]}" ]; }
  else
    [ -e "$1/celorus" ] || [ -L "$1/celorus" ]
  fi
}

# The name of an entry in folder $1's listing that is `celorus` in another case (`Celorus`,
# `CELORUS`) and holds an index.md, or nothing: a desk's record folder misnamed, refused by name
# with the rename, as the engine refuses it. One this machine gives no permission to look inside,
# itself or through a link, may be one: its name, returning 3, refused by name too, as the engine
# refuses it, on the engine's own probe. One
# without an index.md is walked past.
misnamed() {
  [ -r "$1" ] || return 0
  local m said
  for m in "$1"/[cC][eE][lL][oO][rR][uU][sS]; do
    [ "$m" = "$1/celorus" ] && continue
    if [ -e "$m/index.md" ] || [ -L "$m/index.md" ]; then printf '%s' "${m##*/}"; return 0; fi
    # the engine's own probe (lib/desk.js misnamedCelorus): look at $m/index.md without following
    # it, and read the machine's no permission (EACCES, EPERM) as refused by name, a link into a
    # folder that cannot be searched included; a test of $m itself cannot see through such a link
    said="$(LC_ALL=C ls -d -- "$m/index.md" 2>&1 >/dev/null)" && { printf '%s' "${m##*/}"; return 0; }
    case "$said" in *"Permission denied"*|*"Operation not permitted"*) printf '%s' "${m##*/}"; return 3 ;; esac
  done
}

# The line for a misnamed entry $1, found by the door $2 says in words; $3 is misnamed's status (3:
# the entry cannot be searched).
misnamed_said() {
  local walked=""
  case "$2" in "the first "*) walked=", and the walk stops there: no desk above it is used" ;; esac
  if [ "${3:-0}" -eq 3 ]; then
    printf '%s/ cannot be looked inside: this machine gives no permission to search it, so the desk tools cannot tell whether it holds an index.md, and they read a desk only from a folder named exactly celorus/, so %s is no desk the tools can read%s. Give %s/ back its permissions, or rename it to celorus/ if it holds a desk, then ask again. Nothing was changed.' \
      "$1" "$2" "$walked" "$1"
    return 0
  fi
  printf '%s/ holds an index.md, but the desk tools read a desk only from a folder named exactly celorus/, so %s is no desk the tools can read%s. Rename %s/ to celorus/, then ask again. Nothing was changed.' \
    "$1" "$2" "$walked" "$1"
}

# The desk the engine would use (the same stop rule): the folder CELORUS_DESK names, or the first
# folder on the walk up from $PWD, that holds an entry named exactly `celorus`, of any kind. Prints that folder and
# returns 0 only when its celorus/ is a plain folder holding a plain, readable index.md. Prints one
# line naming what is wrong, by its path under that folder, and returns 2 otherwise: never a desk
# above it. Returns 1, printing nothing, when the walk finds no celorus entry. Returns 3, printing
# one line, when the walk is stopped by its step cap or its clock before it reaches the top.
find_desk() {
  local d up where m mk steps=0 named="${CELORUS_DESK:-}"
  local shape="A desk's celorus/ is a plain folder holding a plain, readable index.md: make it one, then ask again."
  local walk="the first folder on the walk up from the working folder that holds a celorus entry"
  local cut="The look for a desk above this folder stopped before it reached the top; start the session inside the desk folder, or set CELORUS_DESK to it."
  if [ -n "$named" ]; then
    d="$named"
    if ! holds_celorus "$d"; then
      m="$(misnamed "$d")"; mk=$?
      if [ -n "$m" ]; then misnamed_said "$m" "the folder CELORUS_DESK names, ${named}," "$mk"; return 2; fi
      printf 'CELORUS_DESK names %s, which holds no celorus/index.md. Set CELORUS_DESK to the desk folder (the one holding celorus/index.md), or name that folder as `desk`.' "$named"
      return 2
    fi
    where="so the folder CELORUS_DESK names, ${named}, is no desk the tools can read. ${shape}"
  else
    d="${PWD}"
    # A start in Windows form (C:\Users\x, C:/Users/x) is turned into the folder's path in bash's
    # own form when cygpath is there to do it; a POSIX path is never passed to cygpath.
    case "$d" in
      [A-Za-z]:[\\/]*|*\\*) command -v cygpath >/dev/null 2>&1 && d="$(cygpath -u -- "$d" 2>/dev/null || printf '%s' "$d")" ;;
    esac
    while [ -n "$d" ] && [ "$d" != "/" ] && ! holds_celorus "$d"; do
      # a walk that has climbed WALK_STEPS folders, or run past WALK_SECONDS since the hook began,
      # stops where it is and says so (returning 3): it never outlasts the hook's budget, and it
      # does not say that no desk exists, since one may sit above the folder it reached
      steps=$((steps + 1))
      if [ "$steps" -gt "$WALK_STEPS" ] || [ "$SECONDS" -ge "$WALK_SECONDS" ]; then printf '%s' "$cut"; return 3; fi
      m="$(misnamed "$d")"; mk=$?
      if [ -n "$m" ]; then misnamed_said "$m" "$walk" "$mk"; return 2; fi
      up="$(dirname "$d")"
      # The walk ends where dirname stops climbing (".", "C:", "//" or the folder itself): a path
      # in a form this walk cannot climb finds no desk, and never loops. A POSIX working folder
      # is absolute, so dirname never answers "." for one.
      if [ "$up" = "$d" ] || [ "$up" = "." ]; then d=""; break; fi
      d="$up"
    done
    [ -n "$d" ] && [ "$d" != "/" ] || return 1
    where="so the first folder on the walk up from the working folder that holds a celorus entry is no desk the tools can read, and the walk stops there: no desk above it is used. ${shape}"
  fi
  local e="$d/celorus" fault=""
  if [ -L "$e" ]; then
    local kind
    kind="$(link_kind "$e")"
    if [ "$kind" = "a link to a folder" ]; then
      fault="$(index_fault "$e")"
      if [ -z "$fault" ]; then
        printf 'celorus/ is a link to a folder, in %s: the desk tools read that desk through the link and write nothing through it, and no desk above it is used. Put a plain folder in its place, then ask again.' \
          "$([ -n "$named" ] && printf 'the folder CELORUS_DESK names, %s' "$named" || printf 'the first folder on the walk up from the working folder that holds a celorus entry')"
        return 2
      fi
      [ "$fault" = "celorus/ holds no index.md" ] && fault="celorus/ is a link to a folder that holds no index.md"
    else
      fault="celorus/ is ${kind}"
    fi
  elif [ ! -d "$e" ]; then
    if [ -f "$e" ]; then fault="celorus is a file, not a folder"; else fault="celorus is $(odd_kind "$e"), not a folder"; fi
  else
    fault="$(index_fault "$e")"
  fi
  if [ -n "$fault" ]; then
    printf '%s, %s' "$fault" "$where"
    return 2
  fi
  printf '%s' "$d"
  return 0
}

# frontmatter_value FILE KEY: the first "KEY: value" inside the leading --- block,
# at any indentation, trailing blanks trimmed. A double-quoted value loses its quotes, and each
# backslash keeps only the character after it (\" reads as ", \\ as \; a backslash at the very
# end stays); a single-quoted one loses its quotes, keeps any double quote, and reads a doubled
# single quote as one; any other value loses every double quote. Empty when absent.
frontmatter_value() {
  awk -v key="$2" -v q="'" '
    { sub(/\r$/, "") }
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (index(line, key ":") == 1) {
        v = substr(line, length(key) + 2)
        sub(/^[ \t]+/, "", v)
        sub(/[ \t]+$/, "", v)
        if (length(v) >= 2 && substr(v, 1, 1) == "\"" && substr(v, length(v), 1) == "\"") {
          v = substr(v, 2, length(v) - 2)
          out = ""
          for (i = 1; i <= length(v); i++) {
            c = substr(v, i, 1)
            if (c == "\\" && i < length(v)) { i++; c = substr(v, i, 1) }
            out = out c
          }
          v = out
        } else if (length(v) >= 2 && substr(v, 1, 1) == q && substr(v, length(v), 1) == q) {
          v = substr(v, 2, length(v) - 2)
          gsub(q q, q, v)
        } else {
          gsub(/"/, "", v)
        }
        print v
        exit
      }
    }
  ' "$1"
}

# frontmatter_every FILE KEY: every value KEY has in the leading --- block, one a line, as written:
# at any indentation, a carriage return read as a line break (as the engine reads one), and only
# the spaces at its ends taken off. A line that holds KEY as a key elsewhere (after { or , in a
# one-line mapping such as `celorus: {desk: S, KEY: x}`, or with blanks before its colon) is printed
# whole, so its reader takes it as a value. Nothing when absent.
frontmatter_every() {
  tr '\r' '\n' < "$1" | awk -v key="$2" '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    NR > 1 {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (index(line, key ":") == 1) {
        v = substr(line, length(key) + 2)
        sub(/^ +/, "", v)
        sub(/ +$/, "", v)
        print v
      } else if (line ~ ("(^|[{,])[ \t]*" key "[ \t]*:")) {
        print line
      }
    }
  '
}

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  # any other control character would break the JSON: dropped, each named, no locale range
  s="${s//[$'\001\002\003\004\005\006\007\010\013\014\016\017\020\021\022\023\024\025\026\027\030\031\032\033\034\035\036\037']/}"
  printf '%s' "$s"
}

emit() {
  local ctx shown=""
  ctx="$(escape_for_json "$1")"
  # DESK-384: the one line the person sees, on a session start only (SHOWN_LINE, set below)
  [ -n "$SHOWN_LINE" ] && shown="  \"systemMessage\": \"$(escape_for_json "$SHOWN_LINE")\","$'\n'
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    printf '{\n%s  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$shown" "$ctx"
  else
    printf '{\n  "additionalContext": "%s"\n}\n' "$ctx"
  fi
}

# Whether Node.js 18 or newer is missing here: returns 0 when Node.js is not on the PATH, or its
# --version does not read vNN.x.y with NN at least 18; returns 1 when it does. One call, no more.
node_missing_or_old() {
  command -v node >/dev/null 2>&1 || return 0
  local v major left=$((9 - SECONDS))
  [ "$left" -ge 1 ] || left=1
  v="$(bounded $left node --version 2>/dev/null </dev/null)" || return 0
  v="${v%%$'\n'*}"
  v="${v//$'\r'/}"
  case "$v" in v*) major="${v#v}"; major="${major%%.*}" ;; *) return 0 ;; esac
  case "$major" in ''|*[!0-9]*) return 0 ;; esac
  [ "$major" -ge 18 ] && return 1
  return 0
}

# The assistant's name the start line opens with, the engine's default (lib/persona.js
# DEFAULT_NAME), and the line every start line ends with, except the no-desk, no-sign-in line,
# which asks itself.
NAME="Milan"
RECORD_LINE="To read from our data, sign in to Celorus if you have not: in the Claude app, connect Celorus and your browser opens the Celorus sign-in, and in Claude Code, sign in to celorus-data under /mcp."
# DESK-384: what Milan does and how to start, shown to the person (a top-level systemMessage, which
# the app shows; additionalContext reaches only the model). hooks.json runs the hook with the word
# startup on a start and with none on a clear or a compact, so only a start says it.
SHOWN_LINE=""
[ "${1:-}" = "startup" ] && SHOWN_LINE="${NAME} runs your sales day: who to call first, why now, and what to say. Say '${NAME}, open my day' to start, or '${NAME}, what can you do?' first."

# Whether the link keeps a sign-in on this machine: ~/.celorus/link/token.json is there as a plain
# file, with no link on the way. The file is never opened; a sign-in that has ended still counts,
# and the link asks again when it is used.
link_signed_in() {
  local h="${HOME:-}"
  [ -n "$h" ] || return 1
  [ -d "$h/.celorus" ] && [ ! -L "$h/.celorus" ] &&
    [ -d "$h/.celorus/link" ] && [ ! -L "$h/.celorus/link" ] &&
    [ -f "$h/.celorus/link/token.json" ] && [ ! -L "$h/.celorus/link/token.json" ]
}

# A handle as a name under the desk or ~/.celorus: only lowercase letters, digits and hyphens,
# spelled out so no locale widens the range. Anything else reads as none.
plain_handle() {
  case "$1" in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*) printf '' ;; *) printf '%s' "$1" ;; esac
}

# look_up WALK: masked()'s look-up of one spelling of the path, part by part from the top, each part
# looked up in the folder the last one found as the disk has it, so a run of / or ./ costs nothing
# and never makes a long path. It adds to the caller's more and sets its stop and keep where the
# look-up ends short (the shorter keep of two looks). The system's pwd asks the disk for the names
# as stored; bash's own keeps them as typed. A folder path longer than 250 characters is not looked
# up: it and the rest are hidden, as the system may refuse a long path as if it were not there. As
# the walk up does, it enters WALK_STEPS parts at most and stops at the hook's clock (WALK_SECONDS):
# the part it reached and the rest are hidden then too.
look_up() {
  local rest="$1" part sep said="" pfx cand got last="" steps=0 cut="" k="" nl=$'\n'
  while [ -n "$rest" ]; do
    case "$rest" in
      */*) part="${rest%%/*}" rest="${rest#*/}" sep="/" ;;
      *) part="$rest" rest="" sep="" ;;
    esac
    case "$part" in '' | .) said="${said}${part}${sep}" && continue ;; esac
    pfx="${said}${part}"
    if [ -z "$said" ]; then case "$part" in [A-Za-z]:) pfx="${pfx}/" ;; esac; fi
    if [ -n "$last" ]; then cand="${last%/}/${part}"; else cand="$pfx"; fi
    steps=$((steps + 1))
    if [ "$steps" -gt "$WALK_STEPS" ] || [ "${#cand}" -gt 250 ] || [ "$SECONDS" -ge "$WALK_SECONDS" ]; then
      cut=1 k="$said" && break
    fi
    got="$(cd -P -- "$cand" 2>/dev/null && { /bin/pwd -P 2>/dev/null || pwd -P; } && printf x)"
    # $(...) drops the newlines at the end of what it reads, and a folder's name can end in one: the
    # x after pwd's own newline keeps them, and then the x and pwd's newline go
    case "$got" in *"$nl"x) got="${got%?x}" ;; *) got="" ;; esac
    if [ -z "$got" ]; then
      case "$last" in */[Ss][Ee][Aa][Tt][Ss]) more="${more}/${part}" ;; esac
      if [ -e "$cand" ] || [ -L "$cand" ]; then cut=1 k="$pfx"; fi
      # a .. after a part that is not there climbs back onto the disk, where the hook did not look
      case "/${rest//\\//}/" in */../*) cut=1 k="$pfx" ;; esac
      break
    fi
    if [ "$part" != ".." ]; then
      case "${got%/*}" in */[Ss][Ee][Aa][Tt][Ss]) more="${more}/${part}/${got##*/}" ;; esac
    fi
    last="$got" said="${said}${part}${sep}"
  done
  if [ -n "$cut" ] && { [ -z "$stop" ] || [ "${#k}" -lt "${#keep}" ]; }; then stop=1 keep="$k"; fi
}

# masked TEXT PATH SEAT: TEXT, with each place it says PATH said with the seat's handle hidden. A
# seat's graph sits in a folder named for its seat (<firm>/seats/<seat>), so in PATH, split at / and
# at \, every part that is SEAT, or the part after a seats part, is said as "(your seat)". That
# part is read in PATH as written, in the folder PATH names (under the working folder when PATH is
# relative, each .. taken back), and on the disk. There each part of PATH is looked up in turn from
# the top, as the disk has it (every link followed, the names as stored; a PATH with no / is read at
# its \), and a part whose folder sits in a seats folder is the seat, however it is spelled. The
# first part that cannot be entered ends the look-up. When it is not on the disk, it and the parts
# after it are said as written, unless a .. follows that climbs back onto the disk. When it is there
# but cannot be entered (no permission to search, a link that cannot be followed), or a .. follows
# it, the hook cannot see what the parts after it name, so they are said as "(hidden)"; past
# WALK_STEPS parts, or the hook's clock, the rest is "(hidden)" too. Every match ignores case, as
# macOS's and Windows' disks do. The match is by bytes (LC_ALL=C) and literal: no locale, pattern
# or & reads it.
masked() {
  local where="$2" more="" stop="" keep=""
  case "$where" in /*|\\*|[A-Za-z]:*) ;; *) where="${PWD}/${where}" ;; esac
  if [ -n "$2" ]; then
    look_up "$where"
    case "$2" in */*) ;; *\\*) look_up "${where//\\//}" ;; esac
  fi
  MASK_TEXT="$1" MASK_PATH="$2" MASK_SEAT="$3" MASK_WHERE="$where" MASK_MORE="$more" \
    MASK_STOP="$stop" MASK_KEEP="$keep" LC_ALL=C awk 'BEGIN {
    t = ENVIRON["MASK_TEXT"]; p = ENVIRON["MASK_PATH"]; seat = ENVIRON["MASK_SEAT"]
    if (p == "") { printf "%s", t; exit }
    n = 1; part[1] = ""; cut[1] = ""
    for (i = 1; i <= length(p); i++) {
      c = substr(p, i, 1)
      if (c == "/" || c == "\\") { cut[n] = c; n++; part[n] = ""; cut[n] = "" }
      else part[n] = part[n] c
    }
    if (seat != "") mine[tolower(seat)] = 1
    x = split(ENVIRON["MASK_MORE"], extra, "/")
    for (k = 1; k <= x; k++) if (extra[k] != "") mine[tolower(extra[k])] = 1
    before = ""
    for (k = 1; k <= n; k++) {
      if (part[k] == "" || part[k] == "." || part[k] == "..") continue
      if (before == "seats") mine[tolower(part[k])] = 1
      before = tolower(part[k])
    }
    w = ENVIRON["MASK_WHERE"]
    m = 0; piece = ""
    for (i = 1; i <= length(w) + 1; i++) {
      c = (i <= length(w)) ? substr(w, i, 1) : "/"
      if (c == "/" || c == "\\") {
        if (piece == "..") { if (m > 0) m-- }
        else if (piece != "" && piece != ".") { m++; folder[m] = tolower(piece) }
        piece = ""
      } else piece = piece c
    }
    for (k = 2; k <= m; k++) if (folder[k - 1] == "seats") mine[folder[k]] = 1
    # Below a part the look-up could not enter, nothing is said: PATH is said up to its byte limit.
    limit = length(p) + 1
    if (ENVIRON["MASK_STOP"] != "") limit = length(ENVIRON["MASK_KEEP"]) - (length(w) - length(p))
    shown = ""; at = 0
    for (k = 1; k <= n; k++) {
      if (at + length(part[k]) > limit) { shown = shown "(hidden)"; break }
      shown = shown ((tolower(part[k]) in mine) ? "(your seat)" : part[k]) cut[k]
      at += length(part[k]) + length(cut[k])
    }
    # each place TEXT says PATH, left to right; the loop ends, as each pass takes PATH off the text
    for (out = ""; (i = index(t, p)) > 0; t = substr(t, i + length(p))) out = out substr(t, 1, i - 1) shown
    printf "%s", out t
  }'
}

# The copy the conversion leaves of a desk (DESK-391): <desk>-before-convert-<YYYY-MM-DD>[-<n>], or
# that name plus .partial when the copy was cut short. It is told by the desk folder's own name,
# the pattern of engine/lib/tools.js DATED_COPY and link/lib/seed.js (pinned to agree by test), and
# the name is the folder's real one, as the engine reads it: a folder reached as `.`, with a slash
# at its end or through a link is known by the name it has on disk. The date said is the name's.
dated_re='^.+-before-convert-([0-9]{4}-[0-9]{2}-[0-9]{2})(-[0-9]+)?(\.partial)?$'
dated_on="" dated_partial=""
dated_copy_name() {
  local f="$1" p base
  [ -n "$f" ] || return 1
  p="$(CDPATH= cd -P -- "$f" 2>/dev/null && pwd -P)" || p=""
  [ -n "$p" ] || p="${f%/}"
  base="${p##*/}"
  [[ $base =~ $dated_re ]] || return 1
  dated_on="${BASH_REMATCH[1]}"
  dated_partial="${BASH_REMATCH[3]}"
  return 0
}
dated_emit() {
  # A copy is no desk the person starts in: the first words are not said here (DESK-384).
  SHOWN_LINE=""
  if [ -n "$dated_partial" ]; then
    emit "${greeting}This folder is a copy the conversion started on ${dated_on} and did not finish. It is not a desk: write nothing in it, and do not restore from it.${node_note}
${RECORD_LINE}"
  else
    emit "${greeting}This folder is a copy of the desk as it stood before the conversion on ${dated_on}, kept as it was. It is not the live desk: write nothing in this folder.${node_note}
The live desk is your seat's graph, in the firm folder the conversion made beside the desk.
To open it, start a session in your seat's own folder there, then say '${by_name}open my day'.
If your seat has no folder there, it was not converted: ask whoever ran the conversion.
${RECORD_LINE}"
  fi
}

found=0
desk="$(find_desk)" || found=$?
node_note=""
if node_missing_or_old; then
  node_note=" Node.js 18 or newer is missing or too old on this computer, so the desk tools and the sign-in cannot start, and the plugin's guard refuses the use of every other connector (mail, calendar, any connector but the Celorus data server's own tools) until it is installed; offer to install it now with the install-desk skill, and install it only if the person says yes."
fi
# A copy the conversion left, cut short before its celorus/index.md, is no desk the walk can read: its
# name is looked at first, the folder CELORUS_DESK names or else the working folder, and the copy's
# words are said in place of the walk's message.
greeting="${NAME} here. "
by_name="${NAME}, "
if [ "$found" -ne 0 ] && dated_copy_name "${CELORUS_DESK:-$PWD}"; then dated_emit; exit 0; fi
if [ "$found" -eq 2 ] || [ "$found" -eq 3 ]; then
  # A desk the walk could not read (a broken celorus entry, no index.md) is no live desk: the first
  # words are not said here either (DESK-384).
  SHOWN_LINE=""
  # The one path a fault line says is CELORUS_DESK's value, as it was set: said with the seat its
  # desk.md names hidden too, when celorus/desk.md there is a plain file under a plain folder.
  named="${CELORUS_DESK:-}" named_seat=""
  if [ -n "$named" ] && [ -d "$named/celorus" ] && [ ! -L "$named/celorus" ] &&
    [ -f "$named/celorus/desk.md" ] && [ ! -L "$named/celorus/desk.md" ] && [ -r "$named/celorus/desk.md" ]; then
    named_seat="$(plain_handle "$(frontmatter_value "$named/celorus/desk.md" seat 2>/dev/null)")"
  fi
  emit "${NAME} here. Celorus is installed. $(masked "$desk" "$named" "$named_seat")${node_note}
${RECORD_LINE}"
  exit 0
elif [ "$found" -ne 0 ]; then
  if link_signed_in; then
    emit "${NAME} here. Say '${NAME}, open my day' to set up your desk and start, or '${NAME}, what can you do?' first.${node_note}
${RECORD_LINE}"
  else
    # The opening line already asks to sign in, so RECORD_LINE is not added: one sign-in ask on a
    # fresh machine (the user-testing walk's check 1 found two on 0.23.53).
    emit "${NAME} here. Celorus is installed. Sign in (it is free) and say '${NAME}, set up my desk'.${node_note}"
  fi
  exit 0
fi

stamps="$desk/celorus/desk.md"
[ -f "$stamps" ] || stamps="$desk/celorus/index.md"
desk_name="$(frontmatter_value "$stamps" desk)"
desk_id="$(plain_handle "$(frontmatter_value "$stamps" desk_id)")"
# A desk that sets its own assistant_name is greeted with no name: the engine reads and says it.
# The hook greets only when every assistant_name line in the header, at any indentation, is one the
# engine reads as none, written in one of these shapes: nothing, null, Null, NULL, ~, or a pair of
# quotes holding only spaces, each with or without a comment (spaces, then #) after it; or only a
# comment. Blanks are spaces alone, spelled out, as the engine reads them. Any other value, one the
# engine refuses included, gets no name here: the hook never says a name the desk did not choose.
greeting="${NAME} here. "
by_name="${NAME}, "
own_none="^((null|Null|NULL|~|\"[ ]*\"|'[ ]*')?([ ]+#.*)?|#.*)\$"
# Each line in turn, split at newlines alone and with no * or ? read as a pattern, in a subshell so
# neither setting reaches the rest of the hook; a blank line, which the split drops, is none anyway.
own_set="$(
  IFS=$'\n'
  set -f
  for own_raw in $(frontmatter_every "$stamps" assistant_name); do
    [[ $own_raw =~ $own_none ]] || { printf 1; break; }
  done
)"
if [ -n "$own_set" ]; then greeting=""; by_name=""; SHOWN_LINE=""; fi
# The copy the conversion leaves of a desk (DESK-391), said by dated_emit: told by the desk folder's
# name alone, read as the engine reads it (dated_copy_name), and a copy cut short before its
# celorus/index.md is told by the same name, ahead of the walk's own message about a desk it cannot
# read. Nothing is written in the copy, and a copy renamed back is greeted as a desk again.
if dated_copy_name "$desk"; then dated_emit; exit 0; fi
# A desk the converter has switched (desk.md says `converted:`) is history: its work lives in the
# seat's graph, so this folder is never greeted as a desk that is ready. Only a top-level key counts,
# as the engine reads it (lib/tools.js convertedState): `converted:` at the start of a line in the
# header, never one indented under another key or written after a comma or brace. The date is said
# only when it reads as a date; the line says nothing else of the desk. A carriage return is read as
# a line break (tr), as the engine reads one, so a desk.md with lone CR line ends is read as any other.
converted_line="$(tr '\r' '\n' < "$stamps" | awk '
  NR == 1 && $0 != "---" { exit }
  NR > 1 && $0 == "---" { exit }
  NR > 1 && substr($0, 1, 10) == "converted:" {
    v = substr($0, 11)
    sub(/^[ \t]+/, "", v)
    sub(/[ \t]+$/, "", v)
    gsub(/"/, "", v)
    print "Y" v
    exit
  }
')"
if [ -n "$converted_line" ]; then
  converted_on="${converted_line#Y}"
  as_of=""
  case "$converted_on" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) as_of=" as of ${converted_on}" ;;
  esac
  SHOWN_LINE=""
  emit "${greeting}This folder is the desk's history${as_of}. It was converted, and it is kept as it was.${node_note}
The live desk is your seat's graph, in the firm folder the conversion made beside this folder. New work goes there, not here: write nothing in this folder.
To open it, start a session in your seat's own folder there, then say '${by_name}open my day'.
If your seat has no folder there, it was not converted: ask whoever ran the conversion.
${RECORD_LINE}"
  exit 0
fi
# A seat's graph, layout 3: the desk a first bring-down leaves, whose desk.md names its seat.
graph=0
[ "$(frontmatter_value "$stamps" layout_version)" = "3" ] && graph=1

# The seat: on a seat's graph, the one its desk.md names first; then CELORUS_SEAT, then this
# machine's pointer. Each is a plain handle or none.
seat=""
[ "$graph" -eq 1 ] && seat="$(plain_handle "$(frontmatter_value "$stamps" seat)")"
[ -z "$seat" ] && seat="$(plain_handle "${CELORUS_SEAT:-}")"
if [ -z "$seat" ] && [ -n "$desk_id" ] && [ -f "${HOME:-/nonexistent}/.celorus/seat-${desk_id}" ]; then
  seat="$(plain_handle "$(head -n 1 "${HOME}/.celorus/seat-${desk_id}" | tr -d '[:space:]')")"
fi
# Where the pages are: a seat's graph keeps the board in personal/, the follow-ups in shared/, and a
# seat's page in shared/, personal/ or team/ (the layout of a graph); other desks keep them flat.
if [ "$graph" -eq 1 ]; then
  seat_dirs="shared/seats personal/seats team/seats"
  boards="$desk/celorus/personal/today"
  queue="$desk/celorus/shared/queues/follow-ups.md"
else
  seat_dirs="seats"
  boards="$desk/celorus/today"
  queue="$desk/celorus/queues/follow-ups.md"
fi
role=""
if [ -n "$seat" ]; then
  for dir in $seat_dirs; do
    page="$desk/celorus/${dir}/${seat}.md"
    if [ -f "$page" ] && [ ! -L "$page" ]; then
      role="$(plain_handle "$(frontmatter_value "$page" role)")"
      break
    fi
  done
fi
if [ -n "$seat" ] && [ "$graph" -eq 1 ]; then
  # the graph's own seat, its handle never said
  seat_line="your own seat${role:+ (${role})}"
elif [ -n "$seat" ]; then
  seat_line="seat ${seat}${role:+ (${role})}"
elif [ "$graph" -eq 1 ]; then
  seat_line="its desk.md names no seat"
else
  seat_line="no seat claimed on this machine"
fi

today="$(date +%F)"
board="not yet opened"
if [ -f "$boards/${today}.md" ]; then
  opened="$(frontmatter_value "$boards/${today}.md" opened_at)"
  board="opened${opened:+ at ${opened}}"
fi

due=0
if [ -f "$queue" ]; then
  due="$(awk -F'|' -v t="$today" '
    !in_table {
      if ($0 ~ /^\|[ -]*-/) in_table = 1
      next
    }
    NF >= 7 {
      by = $(NF-3); st = $(NF-1)
      gsub(/[ \t]/, "", by); gsub(/[ \t]/, "", st)
      if (st == "due" && by != "" && by <= t) n++
    }
    END { print n + 0 }
  ' "$queue")"
fi
if [ "$due" = "1" ]; then
  due_line="1 follow-up is due"
else
  due_line="${due} follow-ups are due"
fi

# The next step, from what the desk has: a seat to claim, the day to open, the follow-ups due, or
# the day's calls to order. Each is said in the words the skill it leads to answers to.
if [ -z "$seat" ] && [ "$graph" -eq 0 ]; then
  next="say '${by_name}set up my desk' to claim a seat on this machine"
elif [ "$board" = "not yet opened" ]; then
  next="say '${by_name}open my day'"
elif [ "$due" != "0" ]; then
  next="say '${by_name}what do I owe' for the follow-ups due"
else
  next="say '${by_name}order my calls'"
fi

# On a seat's graph the path is said with its seat hidden, whichever way the seat was found.
graph_seat=""
[ "$graph" -eq 1 ] && graph_seat="$seat"
emit "${greeting}A Celorus desk is installed at $(masked "$desk" "$desk" "$graph_seat") for ${desk_name:-this desk}: ${seat_line}.${node_note}
Today's board is ${board}; ${due_line}. The next step: ${next}.
The day opens with the day-open skill; the chain and the layout are in celorus/index.md.
Before your first answer, read how you speak on this desk with the read_soul tool.
${RECORD_LINE}"
exit 0
